# Auto detect text files and perform LF normalization
* text=auto

# cmd batch scripts break when checked out with LF line endings
*.bat text eol=crlf

# Updater fixtures are signature-verified byte-for-byte; never normalize them
tools/fixtures/updater/** -text

# pw-contracts's export-bindings binary always writes LF. Pin these
# generated files to LF so a checkout never disagrees with a fresh
# `cargo run -p pw-contracts --bin export-bindings`, on any OS.
packages/contracts/src/generated/** text eol=lf
packages/contracts/src/index.ts text eol=lf

# tauri-build rewrites these on every build and always writes LF. Without
# this, a CRLF checkout makes every `cargo build` dirty the whole directory
# with line-ending-only diffs.
apps/desktop/src-tauri/gen/schemas/** text eol=lf
apps/desktop/src-tauri/permissions/autogenerated/** text eol=lf
