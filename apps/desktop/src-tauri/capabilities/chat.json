{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "chat",
  "description": "Chat window: conversation history and text input. Exposes app status, message submission and turn cancellation.",
  "windows": [
    "chat"
  ],
  "permissions": [
    "core:default",
    "allow-get-app-status",
    "allow-send-chat-message",
    "allow-cancel-turn",
    "allow-list-conversation-history",
    "allow-report-frontend-error"
  ]
}
