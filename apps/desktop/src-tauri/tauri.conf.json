{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Parallel World",
  "version": "0.1.0",
  "identifier": "world.parallel.desktop",
  "build": {
    "beforeBuildCommand": "corepack pnpm build",
    "beforeDevCommand": "corepack pnpm dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "capabilities": ["character", "chat", "settings"],
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
